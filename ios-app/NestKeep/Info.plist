<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>巢记+</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.6.3</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- 主屏图标：显式列出实体 PNG 文件名。
         新版 Xcode 的 actool 只把图标编进 Assets.car，CFBundleIconFiles 指向的
         loose PNG 会退化成全透明占位图；构建脚本会把这些真实图标覆盖进 App 包。 -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon29x29</string>
                <string>AppIcon40x40</string>
                <string>AppIcon60x60</string>
            </array>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon29x29</string>
                <string>AppIcon40x40</string>
                <string>AppIcon76x76</string>
            </array>
        </dict>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- 高刷：解锁 App 进程 Core Animation 的 60fps 上限，ProMotion 设备（如 iPhone 13 Pro）可跑满 120Hz -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIBackgroundModes</key>
    <array/>
    <!-- 一键安装：TrollStore 用系统「放大器」的 scheme 做安装入口（规避越狱检测）。
         iOS 9+ 起 canOpenURL 必须先在此声明白名单，否则恒为 false。 -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>apple-magnifier</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <!-- 应用锁：使用 Face ID 解锁时需要声明用途，否则系统会直接拒绝评估 -->
    <key>NSFaceIDUsageDescription</key>
    <string>用于快速解锁「巢记」，解锁后即可查看你的账目数据。</string>
    <!-- 交易地理位置：记账时可选记录当前位置，需声明用途 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于在记账时记录交易发生的位置。</string>
</dict>
</plist>
